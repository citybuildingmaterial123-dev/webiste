# Copy this file to `.env.local` (local builds) or set the same variables in your
# hosting provider's dashboard (Vercel / Netlify / Cloudflare Pages ...).
# Never commit real secrets. Only variables starting with NEXT_PUBLIC_ reach the browser.

# ---------------------------------------------------------------------------
# Public site settings (baked into the static pages at build time)
# ---------------------------------------------------------------------------

# Full public URL of the site, without a trailing slash. Used for canonical URLs,
# the sitemap and social share previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp number that receives quotation requests: country code + number,
# digits only (no +, spaces or leading zeros). India example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: phone number shown on the site and used for "Call" links.
# Defaults to the value in config/site.ts.
NEXT_PUBLIC_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Google Sheets product catalogue (read only by scripts/sync-catalog.ts at build time)
# ---------------------------------------------------------------------------

# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Which tab to read.
#  - Public sheets (no credentials): set the tab's gid (the number after `#gid=` in the URL).
#  - API key / service account: set the tab name.
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_TAB=Products

# Option A (simplest): share the sheet as "Anyone with the link: Viewer" and set nothing else.
# Option B: File > Share > Publish to web > CSV, and paste that URL here (overrides the ID).
GOOGLE_SHEET_CSV_URL=

# Option C: Google Sheets API key (sheet must still be viewable by link).
GOOGLE_SHEETS_API_KEY=

# Option D: private sheet. Create a service account, share the sheet with its email
# as Viewer, and paste its credentials here. Keep the \n sequences in the key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Build behaviour
# ---------------------------------------------------------------------------

# When the sheet cannot be fetched: `true` fails the build (your live site keeps its
# previous version); `false` falls back to the last good copy, then to the sample data.
# Defaults to `true` on CI servers (CI=true) and `false` on your own computer.
CATALOG_STRICT=

# `optimize` (default) downloads product photos and converts them to small WebP files.
# `remote` links to the original image URLs instead (faster builds, slower pages).
CATALOG_IMAGES=optimize
